# Copy to deploy/.env.production, replace all placeholders, and keep that file out of Git.
PUBLIC_HOST=platform.example.dz
POSTGRES_DB=hawdh
POSTGRES_USER=hawdh_app
POSTGRES_PASSWORD=replace-with-a-unique-random-database-secret
SEED_ADMIN_EMAIL=admin@example.dz
SEED_ADMIN_PASSWORD=replace-with-a-unique-strong-initial-admin-password
SMTP_HOST=smtp.example.dz
SMTP_PORT=587
SMTP_SECURITY=StartTls
SMTP_USERNAME=replace-with-your-smtp-username
SMTP_PASSWORD=replace-with-your-smtp-password
SMTP_FROM_ADDRESS=no-reply@example.dz
SMTP_FROM_NAME=AGIRE TAIRET
