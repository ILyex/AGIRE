@page "/Account/ForgotPasswordConfirmation"
@attribute [AllowAnonymous]
@inject UiText T

<PageTitle>@T["passwordRecoveryTitle"] — @T["brand"]</PageTitle>
<div class="auth-screen"><main class="auth-card" role="status">
    <div class="auth-heading-icon"><AppIcon Name="check" Size="20" /></div>
    <h1 class="auth-title">@T["passwordRecoveryTitle"]</h1>
    <p class="auth-subtitle">@T["passwordRecoverySent"]</p>
    <a class="btn-main" href="/Account/Login">@T["backToLogin"]</a>
</main></div>

