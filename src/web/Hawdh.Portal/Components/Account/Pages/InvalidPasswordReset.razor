@page "/Account/InvalidPasswordReset"
@attribute [AllowAnonymous]
@inject UiText T

<PageTitle>@T["resetPasswordTitle"] — @T["brand"]</PageTitle>
<div class="auth-screen auth-screen-standalone"><main class="auth-card" role="alert">
    <div class="auth-heading-icon"><AppIcon Name="warning" Size="20" /></div>
    <h1 class="auth-title">@T["resetPasswordTitle"]</h1>
    <p class="auth-subtitle">@T["invalidPasswordResetLink"]</p>
    <a class="btn-main" href="/Account/ForgotPassword">@T["passwordRecoveryTitle"]</a>
</main></div>

