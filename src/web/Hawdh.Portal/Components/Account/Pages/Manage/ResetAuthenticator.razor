@page "/Account/Manage/ResetAuthenticator"

@using Microsoft.AspNetCore.Identity
@using Hawdh.Portal.Data
@inject UiText T
@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject ILogger<ResetAuthenticator> Logger

<PageTitle>@T["resetAuthenticator"] — @T["brand"]</PageTitle>

<div class="account-security-page">
    <StatusMessage />
    <header class="account-security-heading">
        <span class="account-security-icon is-warning"><AppIcon Name="refresh" Size="19" /></span>
        <div><h2>@T["resetAuthenticator"]</h2><p>@T["authenticatorResetWarning"]</p></div>
    </header>
    <div class="account-security-notice is-critical" role="alert">
        <AppIcon Name="warning" Size="17" />
        <div><b>@T["authenticatorResetWarning"]</b><p>@T["twoFactorCodesHint"]</p></div>
    </div>
    <form class="account-security-actions" @formname="reset-authenticator" @onsubmit="OnSubmitAsync" method="post">
        <AntiforgeryToken />
        <button class="btn-danger-outline" type="submit"><AppIcon Name="refresh" Size="15" />@T["confirmResetAuthenticator"]</button>
        <a href="/Account/Manage/TwoFactorAuthentication" class="btn-outline">@T["cancel"]</a>
    </form>
</div>

@code {
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private async Task OnSubmitAsync()
    {
        var user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var disabled = await UserManager.SetTwoFactorEnabledAsync(user, false);
        if (!disabled.Succeeded)
        {
            Logger.LogError("Could not disable two-factor authentication before resetting the key for user {UserId}.", user.Id);
            RedirectManager.RedirectToWithStatus("/Account/Manage/TwoFactorAuthentication", T["operationFailed"], HttpContext);
            return;
        }

        var reset = await UserManager.ResetAuthenticatorKeyAsync(user);
        if (!reset.Succeeded)
        {
            Logger.LogError("Could not reset authenticator key for user {UserId}: {Errors}.", user.Id, string.Join(",", reset.Errors.Select(error => error.Code)));
            await SignInManager.RefreshSignInAsync(user);
            RedirectManager.RedirectToWithStatus("/Account/Manage/TwoFactorAuthentication", T["operationFailed"], HttpContext);
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        Logger.LogInformation("User with ID '{UserId}' has reset their authentication app key.", user.Id);
        RedirectManager.RedirectToWithStatus("/Account/Manage/EnableAuthenticator", T["authenticatorResetWarning"], HttpContext);
    }
}
