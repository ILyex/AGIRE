@page "/Account/Manage/SetPassword"
@attribute [Authorize(Policy = "AdminMfa")]

@using System.ComponentModel.DataAnnotations
@using Hawdh.Portal.Data
@using Hawdh.Portal.Localization
@using Microsoft.AspNetCore.Identity

@inject UserManager<ApplicationUser> UserManager
@inject SignInManager<ApplicationUser> SignInManager
@inject IdentityRedirectManager RedirectManager
@inject UiText T

<PageTitle>@T["setPasswordTitle"] — @T["brand"]</PageTitle>

<section class="account-security-page password-change-page set-password-page">
    <header class="account-security-heading">
        <span class="account-security-icon"><AppIcon Name="key" Size="20" /></span>
        <div><h2>@T["setPasswordTitle"]</h2><p>@T["setPasswordHint"]</p></div>
    </header>
    <StatusMessage Message="@message" />
    <div class="password-change-layout">
        <EditForm class="account-form-stack account-password-form" Model="Input" FormName="set-password" OnValidSubmit="OnValidSubmitAsync" method="post">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger" role="alert" />
            <div class="account-field">
                <label for="Input.NewPassword">@T["newPassword"]</label>
                <InputText type="password" @bind-Value="Input.NewPassword" id="Input.NewPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                <ValidationMessage For="() => Input.NewPassword" class="text-danger" />
            </div>
            <div class="account-field">
                <label for="Input.ConfirmPassword">@T["confirmNewPassword"]</label>
                <InputText type="password" @bind-Value="Input.ConfirmPassword" id="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" />
                <ValidationMessage For="() => Input.ConfirmPassword" class="text-danger" />
            </div>
            <button type="submit" class="btn-main account-form-submit"><AppIcon Name="check" Size="16" />@T["savePassword"]</button>
        </EditForm>
        <aside class="password-security-tip">
            <span class="password-security-tip-icon"><AppIcon Name="shield" Size="18" /></span>
            <div><b>@T["passwordSecurityTitle"]</b><p>@T["passwordPolicyHint"]</p></div>
        </aside>
    </div>
</section>

@code {
    private string? message;
    private ApplicationUser? user;

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    [SupplyParameterFromForm]
    private InputModel Input { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        Input ??= new();

        user = await UserManager.GetUserAsync(HttpContext.User);
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        if (await UserManager.HasPasswordAsync(user))
            RedirectManager.RedirectTo("Account/Manage/ChangePassword");
    }

    private async Task OnValidSubmitAsync()
    {
        if (user is null)
        {
            RedirectManager.RedirectToInvalidUser(UserManager, HttpContext);
            return;
        }

        var result = await UserManager.AddPasswordAsync(user, Input.NewPassword!);
        if (!result.Succeeded)
        {
            message = $"{T["errorPrefix"]}{T["passwordSetFailed"]}";
            return;
        }

        await SignInManager.RefreshSignInAsync(user);
        RedirectManager.RedirectToCurrentPageWithStatus(T["passwordSet"], HttpContext);
    }

    private sealed class InputModel
    {
        [LocalizedRequired]
        [LocalizedPasswordPolicy]
        [DataType(DataType.Password)]
        public string? NewPassword { get; set; }

        [LocalizedRequired]
        [DataType(DataType.Password)]
        [LocalizedPasswordCompare(nameof(NewPassword))]
        public string? ConfirmPassword { get; set; }
    }
}
