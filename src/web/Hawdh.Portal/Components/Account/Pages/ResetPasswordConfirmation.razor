@page "/Account/ResetPasswordConfirmation"
@attribute [AllowAnonymous]
@inject UiText T
<PageTitle>@T["resetPasswordTitle"] — @T["brand"]</PageTitle>
<div class="auth-screen auth-screen-standalone"><main class="auth-card" role="status">
    <div class="auth-heading-icon"><AppIcon Name="check" Size="20" /></div>
    <h1 class="auth-title">@T["resetPasswordTitle"]</h1>
    <p class="auth-subtitle">@T["passwordResetComplete"]</p>
    <a class="btn-main" href="/Account/Login">@T["backToLoginAction"]</a>
</main></div>

