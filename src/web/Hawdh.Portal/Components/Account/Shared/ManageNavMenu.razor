@using Microsoft.AspNetCore.Identity
@using Hawdh.Portal.Data
@inject UiText T
@inject SignInManager<ApplicationUser> SignInManager

<nav class="account-settings-nav" aria-label="@T["accountSettings"]">
    <NavLink class="account-settings-link" href="Account/Manage" Match="NavLinkMatch.All"><AppIcon Name="users" Size="16" /><span>@T["profile"]</span></NavLink>
    <NavLink class="account-settings-link" href="Account/Manage/Email"><AppIcon Name="mail" Size="16" /><span>@T["email"]</span></NavLink>
    <NavLink class="account-settings-link" href="Account/Manage/ChangePassword"><AppIcon Name="key" Size="16" /><span>@T["password"]</span></NavLink>
    @if (hasExternalLogins)
    {
        <NavLink class="account-settings-link" href="Account/Manage/ExternalLogins"><AppIcon Name="users" Size="16" /><span>@T["externalLogins"]</span></NavLink>
    }
    <NavLink class="account-settings-link" href="Account/Manage/TwoFactorAuthentication"><AppIcon Name="shield" Size="16" /><span>@T["twoFactorTitle"]</span></NavLink>
    <NavLink class="account-settings-link" href="Account/Manage/Passkeys"><AppIcon Name="key" Size="16" /><span>@T["passkeys"]</span></NavLink>
    <NavLink class="account-settings-link" href="Account/Manage/PersonalData"><AppIcon Name="reports" Size="16" /><span>@T["personalData"]</span></NavLink>
</nav>

@code {
    private bool hasExternalLogins;

    protected override async Task OnInitializedAsync()
    {
        hasExternalLogins = (await SignInManager.GetExternalAuthenticationSchemesAsync()).Any();
    }
}
