@if (!string.IsNullOrEmpty(DisplayMessage))
{
    var statusMessageClass = IsErrorMessage(DisplayMessage) ? "danger" : "success";
    <div class="alert alert-@statusMessageClass" role="alert">
        @DisplayMessage
    </div>
}

@code {
    private string? messageFromCookie;

    [Parameter]
    public string? Message { get; set; }

    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;

    private string? DisplayMessage => Message ?? messageFromCookie;

    private static bool IsErrorMessage(string? message) =>
        message?.StartsWith("Error", StringComparison.OrdinalIgnoreCase) == true
        || message?.StartsWith("خطأ", StringComparison.Ordinal) == true
        || message?.StartsWith("Erreur", StringComparison.OrdinalIgnoreCase) == true;

    protected override void OnInitialized()
    {
        messageFromCookie = HttpContext.Request.Cookies[IdentityRedirectManager.StatusCookieName];

        if (messageFromCookie is not null)
        {
            HttpContext.Response.Cookies.Delete(IdentityRedirectManager.StatusCookieName);
        }
    }
}
